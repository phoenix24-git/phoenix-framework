<Project>
  <!--
    Shared settings for every C# project in the repo (CLI, framework, tests).
    Moving to .NET 11 is a one-line change of PhoenixTargetFramework (plus global.json).
  -->
  <PropertyGroup>
    <PhoenixTargetFramework>net10.0</PhoenixTargetFramework>
    <TargetFramework>$(PhoenixTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1303;CA1031;CA1848;CA2007;CA1305;CA1307;CA1310;CA1309;CA1062;CA1860;CA1865;CA1866</NoWarn>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Authors>The Phoenix Authors</Authors>
    <Copyright>Copyright 2026 The Phoenix Authors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/phoenix24-git/phoenix-framework</RepositoryUrl>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
