{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/engine/${presetName}",
      "cacheVariables": {
        "PHOENIX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug (unit tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PHOENIX_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-asan",
      "displayName": "Native Debug + Address/UB sanitizers",
      "inherits": "native-debug",
      "cacheVariables": {
        "PHOENIX_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "native-tsan",
      "displayName": "Native Debug + Thread sanitizer (clang, all dependencies instrumented)",
      "inherits": "native-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "wasm64-debug",
      "displayName": "Web wasm64 + pthreads (unit tests under Node)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/emscripten-wasm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm64-release",
      "displayName": "Web wasm64 Release",
      "inherits": "wasm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan"
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan"
    },
    {
      "name": "wasm64-debug",
      "configurePreset": "wasm64-debug"
    },
    {
      "name": "wasm64-release",
      "configurePreset": "wasm64-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm64-debug",
      "configurePreset": "wasm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm64-release",
      "configurePreset": "wasm64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
